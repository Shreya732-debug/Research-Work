+def reference_selection(packet):
+    """One selection path shared by the reference verdict and its explanation."""
+    policy = packet.claim["policy"]
+    cutoff = packet.claim["cutoff_date"]
+    pool = packet.eligible_facts(cutoff)
+    original = [f for f in pool if f["role"] == "original"]
