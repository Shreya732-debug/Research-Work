+"""Contract checks, not evidence of benchmark or trained-model accuracy."""
+import copy
+from datetime import date, timedelta
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from common import load_dataset, read_csv
+from run_rules import compare_with_manual_trace
+from supervisor_demo import evaluate, page, SCENARIOS
+from verifier import RULES, resolve_reference, run_all_rules, run_rule
+
+
+class VerifierContractTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.documents, cls.facts, cls.claims = load_dataset('pilot')
+
+    def case(self, cid, **updates):
+        c = copy.deepcopy(next(c for c in self.claims if c['case_id'] == cid))
+        c.update(updates)
+        return c
+
+    def test_original_pilot_trace_still_reproduced(self):
+        self.assertEqual([], compare_with_manual_trace(run_all_rules(self.claims, self.documents, self.facts)))
+
+    def test_auto_saved_outputs_unchanged_not_validated(self):
+        docs, facts, claims = load_dataset('auto')
+        saved = read_csv(str(Path(__file__).resolve().parents[1] / 'results/rules_auto.csv'))
+        self.assertEqual(saved, run_all_rules(claims, docs, facts))
+
+    def test_named_reports_exclude_future_and_same_day(self):
+        for cid, source in [('P001', 'P19'), ('P002', 'P20')]:
+            for cutoff in ['1900-01-01', self.documents[source]['filing_date']]:
+                c = self.case(cid, cutoff_date=cutoff)
+                for rule in ['B4', 'B4W', 'P']:
+                    with self.subTest(case=cid, cutoff=cutoff, rule=rule):
+                        self.assertEqual('U', run_rule(rule, c, self.documents, self.facts))
+
+    def test_arithmetic_needs_both_eligible_operands(self):
+        for cutoff in ['1900-01-01', '2023-10-13']:
+            c = self.case('P024', cutoff_date=cutoff)
+            for rule in RULES:
+                self.assertEqual('U', run_rule(rule, c, self.documents, self.facts))
+        self.assertEqual('S', run_rule('P', self.case('P024'), self.documents, self.facts))
+
+    def test_same_claim_changes_with_policy_and_cutoff(self):
+        expected = ['S', 'C', 'S', 'U', 'C', 'U']
+        for (_, cid, policy, cutoff), label in zip(SCENARIOS, expected):
+            claim, result, _ = evaluate(cid, policy, cutoff)
+            with self.subTest(case=cid, policy=policy, cutoff=cutoff):
+                self.assertEqual(label, result['label'])
+                self.assertEqual(label, result['simple_control_label'])
+                self.assertNotIn('gold_label', claim)
+
+    def test_unspecified_cannot_ignore_missing_active_interpretation(self):
+        c = self.case('P013', policy='unspecified', cutoff_date='2023-10-25')
+        for rule in ['P', 'B4W']:
+            self.assertEqual('U', run_rule(rule, c, self.documents, self.facts))
+
+    def test_labels_do_not_affect_predictions(self):
+        for c in self.claims:
+            changed = dict(c, gold_label='deliberately incorrect', label_source='test')
+            self.assertEqual(run_rule('P', c, self.documents, self.facts),
+                             run_rule('P', changed, self.documents, self.facts))
+
+    def test_future_documents_cannot_change_as_known_verdict(self):
+        c = self.case('P015')
+        docs, facts = copy.deepcopy(self.documents), copy.deepcopy(self.facts)
+        for f in facts:
+            if docs[f['doc_id']]['filing_date'] >= c['cutoff_date']:
+                f['value'] += 999999
+        self.assertEqual(run_rule('P', c, self.documents, self.facts), run_rule('P', c, docs, facts))
+
+    def test_trace_selected_facts_are_eligible(self):
+        for c in self.claims:
+            for cutoff in ['1900-01-01', c['cutoff_date']]:
+                changed = dict(c, cutoff_date=cutoff)
+                result = resolve_reference(changed, self.documents, self.facts)
+                for f in result['facts']:
+                    if f['selected']:
+                        self.assertLess(self.documents[f['doc_id']]['filing_date'], cutoff)
+
+    def test_no_matching_period_is_underdetermined(self):
+        c = self.case('P013', period_start='1800-01-01', period_end='1800-12-31')
+        self.assertEqual('U', run_rule('P', c, self.documents, self.facts))
+
+    def test_browser_page_escapes_evidence_and_shows_limitations(self):
+        rendered = page('P013', 'as_known_packet', '2023-10-25')
+        self.assertIn('U — Underdetermined', rendered)
+        self.assertIn('Excluded: filed on/after cutoff', rendered)
+        self.assertIn('annotations remain provisional', rendered)
+        self.assertNotIn('gold_label', rendered)
+        with self.assertRaises(ValueError):
+            page('P013', 'as_known_packet', 'not-a-date')
+        with self.assertRaises(ValueError):
+            page('P013', 'explicit_display_comparison')
+
+
+if __name__ == '__main__':
+    unittest.main()
